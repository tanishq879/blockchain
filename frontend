<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voting DApp — Part 5</title>
    <link rel="stylesheet" href="style.css" />
</head>

<body>
    <div class="container">
        <h1>Decentralized Voting DApp</h1>

        <!-- A. Wallet Connection -->
        <div class="section">
            <h2>1. Wallet Connection</h2>
            <button id="connectBtn">Connect MetaMask</button>
            <button id="refreshBtn" class="secondary-btn" disabled>Refresh Results</button>
            <p id="accountInfo" class="info-text">Account: Not connected</p>
            <p id="networkInfo" class="info-text">Network: Not connected</p>
        </div>

        <!-- B & C. Candidate Information & Voting -->
        <div class="section">
            <h2>2. Candidates & Voting</h2>
            <div id="candidatesContainer">
                <p class="info-text">Connect your wallet to load candidates from the smart contract.</p>
            </div>
        </div>

        <!-- D. Status & Error Messages -->
        <div class="section">
            <h2>3. Transaction & Error Status</h2>
            <div id="statusBox" class="status-box">Ready. Please connect MetaMask to start.</div>
        </div>
    </div>

    <!-- ethers.js v6 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>
    <!-- Frontend Logic -->
    <script src="script.js"></script>
</body>

</html>
